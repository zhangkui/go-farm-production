# =============================================================================
# go-farm-production  environment template
# Copy to .env and adjust. All keys map to config via APP_*, HTTP_*, MYSQL_*,
# REDIS_*, JWT_*, PASSWORD_*, RATE_*, LOG_* env vars.
# =============================================================================

# Application
APP_NAME=go-farm-production
APP_ENV=dev

# Default admin (seeded on first run when the username is absent)
APP_DEFAULTADMIN_USERNAME=admin
APP_DEFAULTADMIN_PASSWORD=Admin123!
APP_DEFAULTADMIN_EMAIL=admin@farm.local
APP_DEFAULTADMIN_FULLNAME=系统管理员

# HTTP
HTTP_ADDR=:8080
HTTP_READTIMEOUT=15s
HTTP_WRITETIMEOUT=30s
HTTP_IDLETIMEOUT=60s
HTTP_SHUTDOWNTIMEOUT=30s
HTTP_MAXBODYBYTES=10485760

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=farm
MYSQL_PASSWORD=farmsecret
MYSQL_DATABASE=farm_production
MYSQL_MAXOPENCONNS=50
MYSQL_MAXIDLECONNS=10
MYSQL_CONNMAXLIFETIME=5m

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT — secret MUST be >=32 bytes in production
JWT_SECRET=change-me-in-production-please-32bytes-min
JWT_ACCESSTOKENTTL=15m
JWT_REFRESHTOKENTTL=168h
JWT_ISSUER=go-farm-production

# Password hashing
PASSWORD_BCRYPTCOST=10

# Rate limiting
RATE_LOGINPERIPPERMIN=5
RATE_LOGINPERUSERPERMIN=10
RATE_WRITEPERMIN=60

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
